{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "globals": [
      "$state",
      "$derived",
      "$effect",
      "$props",
      "$bindable",
      "$inspect",
      "$host",
      "Snippet"
    ]
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/svelte",
    "ultracite/biome/astro"
  ]
}
