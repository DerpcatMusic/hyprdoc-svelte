# ===========================
# HyprDoc Environment Variables
# ===========================
# Copy this file to .env.local and fill in your actual values

# Convex
# Get from: https://dashboard.convex.dev/
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=

# WorkOS Authentication
# Get from: https://dashboard.workos.com/
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
WORKOS_COOKIE_PASSWORD= # Generate with: openssl rand -base64 32

# AI - Google Gemini
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# AI - OpenRouter (Optional, for alternative AI providers)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Email - Resend
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Airtable Integration
# Get from: https://airtable.com/account
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Polar Payments (Optional)
# Get from: https://polar.sh/settings
POLAR_ACCESS_TOKEN=
PUBLIC_POLAR_ORGANIZATION_ID=

# Puppeteer (for PDF generation)
# Path to Chrome/Chromium executable
PUPPETEER_EXECUTABLE_PATH=

# Application
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development
