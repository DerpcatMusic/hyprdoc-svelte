		"@unocss/reset": "^66.5.12",
		"@unocss/transformer-directives": "^66.5.12",
		"@unocss/transformer-variant-group": "^66.5.12",
		"concurrently": "^9.2.1",
		"lucide-svelte": "^0.562.0",
		"paneforge": "^1.0.2",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"typescript": "^5.9.3",
		"ultracite": "^7.0.11",
