{
  "name": "hyprdoc-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "fix": "biome check --write . && svelte-check --tsconfig ./tsconfig.json",
    "validate": "svelte-kit sync && concurrently --kill-others-on-fail -n \"Svelte,Biome\" -c \"bgBlue.bold,bgRed.bold\" \"svelte-check --tsconfig ./tsconfig.json --threshold error\" \"biome check .\"",
    "check:all": "bun run validate",
    "knip": "bunx knip --config knip.json",
    "knip:production": "bunx knip --config knip.json --production",
    "proof:rust:test": "cargo test --manifest-path rust/hyprproof-core/Cargo.toml",
    "proof:rust:wasm": "CARGO_HOME=\"$PWD/.codex-rust-local/cargo-home-wasm\" RUSTUP_HOME=\"$PWD/.codex-rust-local/rustup-home\" RUSTC=\"$PWD/.codex-rust-local/cargo-home/bin/rustc\" \"$PWD/.codex-rust-local/cargo-home/bin/cargo\" build --manifest-path rust/hyprproof-core/Cargo.toml --target wasm32-unknown-unknown --features wasm --release && \"$PWD/.codex-rust-local/tools/bin/wasm-bindgen\" --target web --out-dir \"$PWD/packages/contract-core/src/wasm\" \"$PWD/rust/hyprproof-core/target/wasm32-unknown-unknown/release/hyprproof_core.wasm\""
  },
  "devDependencies": {
    "@cloudflare/workerd-linux-64": "1.20260111.0",
    "@biomejs/biome": "^2.4.2",
    "@lucide/svelte": "^0.574.0",
    "@sveltejs/adapter-cloudflare": "^7.2.7",
    "@sveltejs/kit": "^2.52.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node-forge": "^1.3.14",
    "@unocss/preset-wind4": "^66.6.0",
    "concurrently": "^9.2.1",
    "lucide-svelte": "^0.574.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.51.2",
    "svelte-check": "^4.4.0",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2",
    "knip": "^5.85.0",
    "typescript": "^5.9.3",
    "workerd": "1.20260111.0",
    "bun-types": "^1.3.2",
    "ultracite": "^7.2.4",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@hyprdoc/contract-core": "workspace:*",
    "@hyprdoc/domain-types": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@iconify-json/lucide": "^1.2.91",
    "@internationalized/date": "^3.11.0",
    "@polar-sh/sdk": "^0.43.1",
    "@polar-sh/sveltekit": "^0.7.3",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-character-count": "^3.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-details": "^3.19.0",
    "@tiptap/extension-emoji": "^3.19.0",
    "@tiptap/extension-file-handler": "^3.19.0",
    "@tiptap/extension-focus": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-mathematics": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-subscript": "^3.19.0",
    "@tiptap/extension-superscript": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-text-align": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-twitch": "^3.19.0",
    "@tiptap/extension-typography": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/extension-unique-id": "^3.19.0",
    "@tiptap/extension-youtube": "^3.19.0",
    "@tiptap/html": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "@unocss/extractor-svelte": "^66.6.0",
    "@workos-inc/node": "^8.7.0",
    "bits-ui": "^2.15.6",
    "clsx": "^2.1.1",
    "cmdk-sv": "^0.0.19",
    "colord": "^2.9.3",
    "convex": "^1.31.7",
    "convex-helpers": "^0.1.112",
    "convex-svelte": "^0.0.12",
    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "gsap": "^3.14.2",
    "katex": "^0.16.28",
    "layerchart": "1.0.13",
    "lowlight": "^3.3.0",
    "mode-watcher": "^1.1.0",
    "node-forge": "^1.3.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "resend": "^6.9.2",
    "runed": "^0.37.1",
    "svelte-sonner": "^1.0.7",
    "svelte-tiptap": "^3.0.1",
    "sveltekit-superforms": "^2.29.1",
    "tslog": "^4.10.2",
    "unocss": "^66.6.0",
    "uuid": "^13.0.0",
    "vaul-svelte": "^0.3.2",
    "zod": "^4.3.6"
  }
}
