{
  "name": "hyprdoc-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "fix": "biome check --write . && svelte-check --tsconfig ./tsconfig.json",
    "validate": "svelte-kit sync && concurrently --kill-others-on-fail -n \"Svelte,Biome\" -c \"bgBlue.bold,bgRed.bold\" \"svelte-check --tsconfig ./tsconfig.json --threshold error\" \"biome check .\"",
    "check:all": "bun run validate"
  },
