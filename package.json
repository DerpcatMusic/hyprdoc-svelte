{
	"name": "hyprdoc-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"fix": "biome check --write . && svelte-check --tsconfig ./tsconfig.json",
		"validate": "svelte-kit sync && concurrently --kill-others-on-fail -n \"Svelte,Biome\" -c \"bgBlue.bold,bgRed.bold\" \"svelte-check --tsconfig ./tsconfig.json --threshold error\" \"biome check .\"",
		"check:all": "bun run validate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@convex-dev/presence": "^0.3.0",
		"@convex-dev/prosemirror-sync": "^0.2.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/bun": "^1.3.5",
		"@types/node-forge": "^1.3.14",
		"@types/qrcode": "^1.5.6",
		"@types/uuid": "^11.0.0",
